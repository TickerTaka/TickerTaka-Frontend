# Backend API base URL (FastAPI). Leave unset or "mock" for local mock data.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# UUID of the app_user row to act as the current user until auth lands.
# Must exist in the backend (see TickerTaka-backend seeds/).
NEXT_PUBLIC_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
